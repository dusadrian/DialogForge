{
    "name": "dialogforge",
    "productName": "DialogForge",
    "version": "1.0.0",
    "main": "dist/scripts/electron-main.js",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "description": "A language-neutral workbench for dialog-driven desktop applications.",
    "author": "Adrian Dusa",
    "license": "SEE LICENSE IN LICENSE",
    "scripts": {
        "build": "node scripts/native-r-helper-artifacts.js --prepare && tsc -p tsconfig.json && node scripts/verify-dataset-metadata-cache.js && node scripts/copy-static.js && node scripts/generate-core-sdk.js && node dist/scripts/package-product-if-requested.js",
        "build:web": "node scripts/build-web.js",
        "bundle:r-helper:native": "node scripts/native-r-helper-artifacts.js --bundle",
        "build:r-helper:native": "node scripts/build-native-r-helper-release.js",
        "import:r-helper:native": "node scripts/native-r-helper-artifacts.js --import",
        "build:r-helper:webr": "node scripts/web-r-helper-artifacts.js --bundle",
        "sdk:core": "node scripts/generate-core-sdk.js",
        "generate:live-script-words": "node scripts/generate-live-script-short-code-words.js",
        "test:r-package-compatibility": "node scripts/test-r-package-compatibility.js",
        "test:packaging:minimatch": "node scripts/check-packaging-minimatch.js",
        "test:packaging:dependencies": "npm run test:packaging:minimatch && node scripts/check-packaging-dependencies.js",
        "test:dialog-anchoring:rendered": "node scripts/rendered-element-anchoring-acceptance.js",
        "test:console:unit": "node scripts/check-console-command-submission.js && node scripts/check-r-runtime-command-interrupt.js && Rscript --vanilla scripts/check-console-expression-printing.R && Rscript --vanilla scripts/check-console-message-output.R && Rscript --vanilla scripts/check-workspace-package-attachment.R && Rscript --vanilla scripts/check-runtime-control-interrupt-envelope.R",
        "test:console": "npm run build && npm run test:console:unit && node scripts/verify-console-command-parity.js --build-web && node scripts/verify-console-command-parity.js --host web --cases interrupt --worker-entry-delay-ms 200 --report artifacts/console-command-parity/early-stop.json --timeout-ms 30000 && node scripts/check-console-regression-detection.js",
        "check:build-ownership": "node scripts/check-build-ownership.js",
        "start": "npm run build && node dist/scripts/start-app.js",
        "dev:watch": "npm run build && node scripts/watch-product.js",
        "dev:web-server": "npm run build:web && node dist/scripts/web-product-dev-server.js --replace-port",
        "verify:electron-product-dialog": "node tests/electron/verify-product-dialog-workflow.js",
        "verify:production": "node scripts/verify-production.js",
        "verify:production:electron": "node scripts/verify-production-electron.js",
        "verify:production:web": "node scripts/verify-production-web.js",
        "renderer:update": "node scripts/update-dialog-renderer.js",
        "test:dialog-renderer:rendered": "node scripts/check-dialog-label-parity.js && node scripts/rendered-canonical-controls.js && node scripts/rendered-canonical-venn.js"
    },
    "devDependencies": {
        "@types/qrcode": "^1.5.6",
        "@types/sortablejs": "^1.15.9",
        "electron": "43.8.3",
        "electron-builder": "26.18.1",
        "esbuild": "^0.28.1",
        "js-yaml": "4.3.2",
        "playwright": "^1.62.0",
        "rimraf": "file:vendor/dialogforge-temp-cleanup-1.0.0.tgz",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@dialogcreator/renderer": "file:vendor/dialogcreator-renderer-0.1.1.tgz",
        "@fontsource/fira-code": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/source-code-pro": "^5.3.0",
        "@jaames/iro": "^5.5.2",
        "@number0/iroh": "0.35.0",
        "diceware-wordlist-en-eff": "1.0.1",
        "electron-updater": "^6.8.12",
        "fs-extra": "10.1.0",
        "lodash.isequal": "file:vendor/dialogforge-lodash-isequal-1.0.0.tgz",
        "monaco-editor": "^0.56.0",
        "preact": "^10.29.7",
        "qrcode": "^1.5.4",
        "sortablejs": "^1.15.7",
        "webr": "^0.6.0"
    },
    "build": {
        "afterPack": "./scripts/prepare-product-runtime.js",
        "afterSign": "./scripts/finalize-product-runtime.js",
        "directories": {
            "output": "build/output"
        },
        "files": [
            "dist/**/*",
            "!dist/r-runtime/native-retired-*/**/*",
            "!dist/r-runtime/native-stage-*/**/*",
            "!dist/r-runtime/source-*/**/*",
            "package.json",
            "product/**/*"
        ],
        "asar": true,
        "asarUnpack": [
            "dist/r-runtime/native/**/*",
            "dist/src/runtime/providers/r/r-sources/**/*",
            "product/runtime/runtimeControlProfile.R",
            "dist/node_modules/@number0/**/*.node"
        ],
        "extraResources": [
            "LICENSE"
        ],
        "mac": {
            "category": "public.app-category.developer-tools",
            "signIgnore": [
                "/r-runtime/native/[^/]+-linux-gnu-[0-9]+\\.[0-9]+\\.[0-9]+/",
                "/r-runtime/native/[^/]+-mingw32-[0-9]+\\.[0-9]+\\.[0-9]+/"
            ],
            "extendInfo": {
                "NSHumanReadableCopyright": "\u00a9 2025-2026 Adrian Dusa \u2014 Academic Non-Commercial License (see LICENSE file for details)."
            },
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                }
            ]
        },
        "win": {
            "legalTrademarks": "Academic Non-Commercial License (see LICENSE file for details).",
            "target": [
                "nsis",
                "portable"
            ]
        },
        "linux": {
            "target": "AppImage",
            "category": "Development;Science"
        }
    },
    "overrides": {
        "monaco-editor": {
            "dompurify": "3.4.17"
        },
        "@electron/get": {
            "global-agent": "4.1.3"
        },
        "app-builder-lib": {
            "minimatch@^10.2.5": "11.0.5"
        },
        "@electron/universal": {
            "minimatch@^9.0.3": "11.0.5"
        },
        "@electron/asar": {
            ".": "4.3.1",
            "glob": "14.0.4",
            "minimatch": "11.0.5"
        },
        "electron-updater": {
            "lodash.isequal": "$lodash.isequal"
        },
        "temp": {
            "rimraf": "$rimraf"
        }
    }
}
