    "customJS": "const labelNames = [\"label_single_left_top\",\"label_clipped_left_top\",\"label_single_center_middle\",\"label_clipped_center_middle\",\"label_single_right_bottom\",\"label_clipped_right_bottom\",\"label_wrapped_left_top\",\"label_wrapped_center_top\",\"label_wrapped_right_top\",\"label_wrapped_left_middle\",\"label_wrapped_center_middle\",\"label_wrapped_right_middle\",\"label_wrapped_left_bottom\",\"label_wrapped_center_bottom\",\"label_wrapped_right_bottom\",\"label_three_lines_center_middle\",\"label_unlimited_center_middle\"];\nconst texts = ['New dataset', 'Neuer Datensatz', 'Nouveau jeu de données'];\nlet textIndex = 0;\nlet repeatCount = 0;\nlet showCount = 0;\n\nonClick(b_cycle, () => {\n    textIndex = (textIndex + 1) % texts.length;\n    labelNames.forEach((name) => setValue(name, texts[textIndex]));\n});\n\nonClick(b_repeat, () => {\n    labelNames.forEach((name) => setValue(name, getValue(name)));\n    setLabel(b_repeat, 'Same value ' + (++repeatCount));\n});\n\nonClick(b_show, () => {\n    labelNames.forEach((name) => {\n        hide(name);\n        show(name);\n    });\n    setLabel(b_show, 'Shown ' + (++showCount));\n});"
