{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "strict": true,
        "noImplicitAny": true,
        "ignoreDeprecations": "6.0",
        "esModuleInterop": true,
        "types": [
            "node"
        ],
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": ".",
        "outDir": "dist"
    },
    "include": [
        "src/**/*.ts"
    ]
}
