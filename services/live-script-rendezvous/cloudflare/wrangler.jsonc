{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "dialogforge-live-script-rendezvous",
    "main": "src/worker.mjs",
    "compatibility_date": "2026-07-18",
    "durable_objects": {
        "bindings": [
            {
                "name": "LIVE_SCRIPT_SESSIONS",
                "class_name": "LiveScriptSessionObject"
            }
        ]
    },
    "exports": {
        "LiveScriptSessionObject": {
            "type": "durable-object",
            "storage": "sqlite"
        }
    },
    "ratelimits": [
        {
            "name": "RENDEZVOUS_RATE_LIMITER",
            "namespace_id": "120260718",
            "simple": {
                "limit": 30,
                "period": 60
            }
        }
    ]
}
